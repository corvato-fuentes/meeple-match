rules_version = '2';

// MVP model: no login, same trust model as firestore.rules — anyone with the
// event's shortCode can upload/read payment proof images for that event.
service firebase.storage {
  match /b/{bucket}/o {
    match /events/{code}/payment-proofs/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
